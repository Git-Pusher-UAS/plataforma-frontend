# Target URL for Vite's /api proxy (Hackathon-app defaults to 3001 in .env and docker-compose)
VITE_API_PROXY_TARGET=http://localhost:3001
# Backend API base prefix (Hackathon-app mounts routes under /api)
VITE_API_PREFIX=/api
# Set to "true" to use local mock data without a running backend
VITE_DATOS_SIMULADOS=false
